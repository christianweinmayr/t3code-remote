{
  "name": "t3code-remote",
  "version": "0.1.0",
  "description": "Companion server for t3code remote iPad access — auto-discovers t3code instances, provides directory browsing and project bootstrap",
  "type": "module",
  "bin": {
    "t3code-remote": "./dist/bin.cjs"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outfile dist/bin.mjs --target node",
    "dev": "bun run --watch src/index.ts"
  },
  "keywords": ["t3code", "remote", "ipad", "companion"],
  "license": "MIT",
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0"
  }
}
